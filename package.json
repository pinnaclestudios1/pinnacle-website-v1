{
  "name": "pinnacle-website",
  "version": "0.1.0",
  "private": true,
  "description": "Pinnacle Studios — The Ascent, guided by the Dot.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "qa:home": "node scripts/qa/home.mjs",
    "qa:contact": "node scripts/qa/contact.mjs",
    "qa:pages": "node scripts/qa/pages.mjs",
    "qa:a11y": "node scripts/qa/a11y.mjs",
    "qa:budget": "node scripts/qa/budget.mjs",
    "qa:lighthouse": "node scripts/qa/lighthouse.mjs",
    "qa:keyboard": "node scripts/qa/keyboard.mjs",
    "qa:browsers": "node scripts/qa/browsers.mjs",
    "qa:todos": "node scripts/qa/todos.mjs",
    "brand:mascot": "node scripts/brand/mascot.mjs",
    "cms:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cms/export-seed.mts"
  },
  "dependencies": {
    "@sanity/client": "^8.16.0",
    "@sanity/image-url": "^2.2.0",
    "@sanity/vision": "^6.24.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "16.4.6",
    "next-sanity": "^13.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^6.24.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
  }
}
