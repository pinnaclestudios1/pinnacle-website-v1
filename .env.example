# Copy to .env.local and fill in. Never commit real values.
# On Vercel: Project → Settings → Environment Variables. NEXT_PUBLIC_* values are built
# into the pages, so redeploy after changing one.

# Public site URL — used for canonical URLs, sitemap and Open Graph.
# TODO: confirm production domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 4 (Contact Summit) — TODO: provide ---
# Every channel is optional. With none configured: development logs the lead to the
# server console; production refuses the submission (so a lead is never silently lost)
# unless CONTACT_DRY_RUN=1 (staging only).
#
# Email via Resend (team notification + auto-reply from a real person):
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL="Asha at Pinnacle <hello@your-domain>"   # TODO: verified sending domain
# CONTACT_TO_EMAIL=team@your-domain
#
# Slack alert (Incoming Webhook URL):
# SLACK_WEBHOOK_URL=
#
# CRM: any endpoint that accepts JSON (HubSpot / Zoho / Notion via Zapier or Make, or direct):
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=            # sent as the x-webhook-secret header
#
# Cloudflare Turnstile (invisible spam check):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
#
# Shared rate limit (Upstash Redis). On Vercel: Storage / Marketplace → Upstash for Redis →
# connect to this project, which sets KV_REST_API_URL + KV_REST_API_TOKEN automatically.
# A database made directly at upstash.com gives these two instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Booking embed (Cal.com or Calendly link):
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-team/20min?embed=true
#
# Newsletter (Brevo):
# BREVO_API_KEY=
# BREVO_LIST_ID=
#
# CONTACT_DRY_RUN=1

# --- Phase 5 (CMS + inner pages) — TODO: provide ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_REVALIDATE_SECRET=            # also set on the Sanity webhook → /api/revalidate
# DECK_URL=https://…/capabilities.pdf  # emailed on request
# CAREERS_TO_EMAIL=careers@your-domain # job applications (defaults to CONTACT_TO_EMAIL)
# NEXT_PUBLIC_LATEST_REEL_URL=         # /hello: latest Instagram reel

# --- Phase 6 (Analytics / monitoring) — TODO: choose and provide ---
# Either GA4 + Clarity (cookies → shown only after "Accept" in the consent banner)
# or Plausible (cookieless → no banner needed). With none set, no analytics load and
# no banner appears. Each one also opens its origins in the Content-Security-Policy.
# NEXT_PUBLIC_GA_ID=G-XXXXXXX
# NEXT_PUBLIC_CLARITY_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain
# SENTRY_DSN=                          # TODO: error monitoring (not wired yet)
